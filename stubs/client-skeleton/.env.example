# =====================================================================================================================
# {{CLIENT_NAME}} - Pine Commerce environment. Copy to .env (commerce:new-client already did) and fill in.
# Never commit .env. After changing it on a server with cached config: php artisan optimize:clear && php artisan optimize
# =====================================================================================================================

# --- Application -----------------------------------------------------------------------------------------------------
APP_NAME="{{CLIENT_NAME_ENV}}"
# production on staging AND live (error pages, caching); local only on a developer machine
APP_ENV=production
# php artisan key:generate - NEVER change it after go-live: it encrypts the stored payment keys and sessions
APP_KEY=
APP_DEBUG=false
# https, no trailing slash. Links, cookies, sitemap, payment return/webhook URLs are built from it
APP_URL=https://{{CLIENT_SLUG}}.example.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_GB
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=warning

# --- Pine Commerce -----------------------------------------------------------------------------------------------------
# Storefront theme = directory name under themes/. Stays "default" until the client theme exists:
# php artisan commerce:theme:make {{CLIENT_SLUG}} --parent=default, then COMMERCE_THEME={{CLIENT_SLUG}}
# (a theme that is not installed is logged as an ERROR on every request/command and falls back to default)
COMMERCE_THEME=default

# --- Database (the shop) -------------------------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# DB_SOCKET=
# The shop tables are never prefixed. Test connection "scratch" = same database, zz_-prefixed tables (install/import
# tests; dropped with commerce:scratch:drop). Must start with zz_
DB_SCRATCH_PREFIX=zz_

# --- Old WordPress / WooCommerce site (importer only - connection "wordpress", forced READ ONLY) --------------------------
# Copy DB_NAME / DB_USER / DB_PASSWORD / DB_HOST / $table_prefix from the old wp-config.php
WP_DB_HOST=localhost
WP_DB_PORT=3306
WP_DB_DATABASE=
WP_DB_USERNAME=
WP_DB_PASSWORD=
# WP_DB_SOCKET=
WP_DB_PREFIX=wp_
# WordPress root on this server (media is copied from {WP_PATH}/wp-content/uploads)
WP_PATH=
# Optional: a running copy of the old site, used to crawl rendered content (Elementor pages, menus)
WP_SITE_URL=
# Host header to send to WP_SITE_URL (e.g. when it is reached by IP)
WP_SITE_HOST=

# --- Sessions, cache, queue (no Redis, no workers; cron optional – see PLAYBOOK "Cron") -------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true on https sites (always, once live)
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
# sync: order emails and stock updates run inside the request - no queue worker to supervise
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# --- Mail (order confirmations, password resets, contact form) -----------------------------------------------------------
# log = write emails to storage/logs (staging; needs LOG_LEVEL=debug above – the log mailer writes at debug level).
# Live: smtp (or ses / postmark / resend with their keys below)
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Sender; Admin › Settings › Emails can override name/address. Use a domain with SPF/DKIM for this server/provider
MAIL_FROM_ADDRESS="shop@{{CLIENT_SLUG}}.example.com"
MAIL_FROM_NAME="${APP_NAME}"
# POSTMARK_API_KEY=
# RESEND_API_KEY=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=eu-west-2

# --- Payments ------------------------------------------------------------------------------------------------------------
# Payment keys are NOT environment variables: an administrator enters them in Admin › Settings › Payments, where
# they are stored encrypted with APP_KEY.
#   Stripe:  publishable key, secret key, webhook signing secret. Webhook endpoint: {APP_URL}/webhooks/stripe
#            (events: payment_intent.succeeded, payment_intent.payment_failed)
#   PayPal:  client id + secret (live or sandbox). Webhook endpoint: {APP_URL}/webhooks/paypal
#            (events: PAYMENT.CAPTURE.COMPLETED, PAYMENT.CAPTURE.DENIED, PAYMENT.CAPTURE.DECLINED)
#   Bank transfer (BACS): account details shown on the thank-you page and the on-hold email.
# Check with: php artisan commerce:doctor

# --- Proxies -----------------------------------------------------------------------------------------------------------
# Only behind a CDN / load balancer: its IPs or CIDRs, comma separated. Empty on a plain LiteSpeed/Apache host.
TRUSTED_PROXIES=
