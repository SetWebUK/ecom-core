# Normalise line endings in the repository
* text=auto eol=lf
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

# Left out of composer dist archives (what client servers download): development-only files.
# Everything the running shop needs (src, config, routes, resources, database, stubs) stays in.
/.github            export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/bin                export-ignore
/docs               export-ignore
/tests              export-ignore
/phpunit.xml.dist   export-ignore
